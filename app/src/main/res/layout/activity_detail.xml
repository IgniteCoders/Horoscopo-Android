<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activities.DetailActivity"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/signImageView"
        android:layout_width="256dp"
        android:layout_height="256dp"
        tools:src="@drawable/aries_icon"
        android:layout_margin="16dp"/>

    <TextView
        android:id="@+id/nameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Horoscope name"
        android:textSize="24sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/datesTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Horoscope dates"
        android:textSize="16sp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/predictionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Prediction..."
            android:textSize="18sp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"/>

    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/activity_detail_navigation_menu" />

</LinearLayout>